# ── Build output ──────────────────────────────────────────────────────────────
build/
F1FFB.exe

# ── Release packaging artifacts ──────────────────────────────────────────────
dist/
*.zip

# ── Runtime artifacts (generated next to the exe) ────────────────────────────
# ImGui window layout
f1ffb_ui.ini
# last-selected profile name
f1ffb_active.txt
# legacy single settings file
f1ffb_settings.ini
# app launch counter (drives the donation reminder)
f1ffb_launches.txt
# "don't remind me again" opt-out flag
f1ffb_nag_off.txt
# Quick Start Guide "don't show this again" opt-out flag
f1ffb_guide_off.txt
# user-set custom UDP port
f1ffb_udp_port.txt
# user FFB profiles
profiles/

# ── Editor / OS cruft ─────────────────────────────────────────────────────────
.vs/
.vscode/
*.user
Thumbs.db
desktop.ini
